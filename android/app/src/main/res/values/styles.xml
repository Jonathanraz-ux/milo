<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Thème de base : forcé en clair, sans barre d'action. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Thème appliqué par BridgeActivity après le splash. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/milo_fond</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/milo_fond</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Empêche le « force dark » d'Android d'inverser les couleurs du jeu. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Thème de lancement : splash crème avec Milo au centre. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/milo_splash</item>
        <item name="windowSplashScreenBackground">@color/milo_fond</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/milo_splash_robot</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Écran de démarrage historique (avant Android 12). -->
    <style name="AppTheme.NoActionBarLaunch.Legacy" parent="AppTheme.NoActionBarLaunch">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
